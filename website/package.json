{
  "name": "uniapp-website",
  "version": "2.1.0",
  "private": true,
  "scripts": {
    "predev": "node scripts/prepare-screenshots.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/prepare-screenshots.mjs",
    "build": "next build",
    "build:gh-pages": "NEXT_PUBLIC_BASE_PATH=/uniapp-upstream npm run build && NEXT_PUBLIC_BASE_PATH=/uniapp-upstream npm run check:export",
    "start": "node scripts/serve-export.mjs",
    "lint": "tsc --noEmit",
    "check:export": "node scripts/check-export.mjs",
    "capture:screenshots": "node ../scripts/media/capture-phone-screenshots.mjs",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "lucide-react": "^1.78.0",
    "next": "^16.4.6",
    "postcss": "^8.5.33",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "sharp": "^0.35.5",
    "typescript": "^7.0.2"
  }
}
