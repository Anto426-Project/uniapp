# Android build configuration.
# Copy this file to .env and fill the values in the production/build environment.

# Optional: release signing values if you build signed APK/AAB from this machine.
RELEASE_STORE_FILE=
RELEASE_STORE_PASSWORD=
RELEASE_KEY_ALIAS=
RELEASE_KEY_PASSWORD=

# Optional: true/false. Keep false for AAB, true for release APK splits.
ENABLE_ABI_SPLITS=
